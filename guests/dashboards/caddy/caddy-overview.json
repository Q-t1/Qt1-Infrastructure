{
  "annotations": {
    "list": []
  },
  "description": "HTTP metrics for the two caddy guests: the WAN-facing proxy in front of headscale (`caddy`) and the tailnet-only proxy in front of the internal apps (`caddy-internal`). Both are scraped over the guest bridge by the monitoring guest's Prometheus; the log panel at the bottom reads their mirrored consoles out of the host journal in Loki.",
  "editable": false,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Summary",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Scrape targets currently answering. One per enabled caddy guest.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 2,
      "options": { "graphMode": "none", "textMode": "value" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum(up{job=\"caddy\", instance=~\"$instance\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Proxies up",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Requests handled per second, all vhosts and status codes.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 3,
      "options": { "graphMode": "area", "textMode": "value" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum(rate(caddy_http_request_duration_seconds_count{job=\"caddy\", instance=~\"$instance\", host=~\"$vhost\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "title": "Requests",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Requests answered with a 5xx, per second. Anything above zero here is caddy or its upstream failing, not a client error.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum(rate(caddy_http_request_duration_seconds_count{job=\"caddy\", instance=~\"$instance\", host=~\"$vhost\", code=~\"5..\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "title": "Server errors",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Requests a handler aborted with an error (caddy's own middleware errors), per second — separate from the status codes above.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 5,
      "options": { "graphMode": "area", "textMode": "value" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum(rate(caddy_http_request_errors_total{job=\"caddy\", instance=~\"$instance\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "title": "Middleware errors",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Requests being handled right now.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 6,
      "options": { "graphMode": "area", "textMode": "value" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum(caddy_http_requests_in_flight{job=\"caddy\", instance=~\"$instance\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "In flight",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "99th percentile round-trip duration over the dashboard's time range.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 7,
      "options": { "graphMode": "area", "textMode": "value" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(caddy_http_request_duration_seconds_bucket{job=\"caddy\", instance=~\"$instance\", host=~\"$vhost\"}[$__rate_interval])))",
          "refId": "A"
        }
      ],
      "title": "p99 latency",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 8,
      "panels": [],
      "title": "Traffic",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Request rate by HTTP status code.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 20, "showPoints": "never", "stacking": { "mode": "normal" } },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 9,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum by (code) (rate(caddy_http_request_duration_seconds_count{job=\"caddy\", instance=~\"$instance\", host=~\"$vhost\"}[$__rate_interval]))",
          "legendFormat": "{{code}}",
          "refId": "A"
        }
      ],
      "title": "Requests by status",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Request rate per vhost. `_other` collects every request whose Host header matches no configured site — scanners and probes off the WAN end up there rather than each inventing its own label.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 20, "showPoints": "never", "stacking": { "mode": "normal" } },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum by (host) (rate(caddy_http_request_duration_seconds_count{job=\"caddy\", instance=~\"$instance\", host=~\"$vhost\"}[$__rate_interval]))",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "title": "Requests by vhost",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Round-trip request duration, from caddy's own histogram.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 0, "showPoints": "never" },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(caddy_http_request_duration_seconds_bucket{job=\"caddy\", instance=~\"$instance\", host=~\"$vhost\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "histogram_quantile(0.90, sum by (le) (rate(caddy_http_request_duration_seconds_bucket{job=\"caddy\", instance=~\"$instance\", host=~\"$vhost\"}[$__rate_interval])))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(caddy_http_request_duration_seconds_bucket{job=\"caddy\", instance=~\"$instance\", host=~\"$vhost\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Bytes in and out per second, from the request/response size histograms.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "showPoints": "never" },
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 12,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum(rate(caddy_http_response_size_bytes_sum{job=\"caddy\", instance=~\"$instance\", host=~\"$vhost\"}[$__rate_interval]))",
          "legendFormat": "responses out",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum(rate(caddy_http_request_size_bytes_sum{job=\"caddy\", instance=~\"$instance\", host=~\"$vhost\"}[$__rate_interval]))",
          "legendFormat": "requests in",
          "refId": "B"
        }
      ],
      "title": "Throughput",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Concurrent requests per proxy.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "showPoints": "never" },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 13,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum by (instance) (caddy_http_requests_in_flight{job=\"caddy\", instance=~\"$instance\"})",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "In-flight requests",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Request rate by method. A burst of anything but GET/HEAD/POST on the WAN-facing proxy is usually a scanner.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 20, "showPoints": "never", "stacking": { "mode": "normal" } },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "id": 14,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum by (method) (rate(caddy_http_request_duration_seconds_count{job=\"caddy\", instance=~\"$instance\", host=~\"$vhost\"}[$__rate_interval]))",
          "legendFormat": "{{method}}",
          "refId": "A"
        }
      ],
      "title": "Requests by method",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "id": 15,
      "panels": [],
      "title": "Process",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Resident memory of the caddy process inside each guest. Both guests are declared with 256M of RAM, so this is the number to watch before raising it.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "showPoints": "never" },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 31 },
      "id": 16,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "process_resident_memory_bytes{job=\"caddy\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "Memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "CPU seconds burned per second — 1 means one core saturated. Each caddy guest has a single vcpu.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "showPoints": "never" },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 31 },
      "id": 17,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "rate(process_cpu_seconds_total{job=\"caddy\", instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "CPU",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Goroutines, and how long the process has been up. A sawtooth in uptime means caddy is restarting.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 0, "showPoints": "never" },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*uptime.*" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 31 },
      "id": 18,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "go_goroutines{job=\"caddy\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}} goroutines",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "time() - process_start_time_seconds{job=\"caddy\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}} uptime",
          "refId": "B"
        }
      ],
      "title": "Goroutines and uptime",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 },
      "id": 19,
      "panels": [],
      "title": "Logs",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "$logs" },
      "description": "Each caddy guest mirrors its service logs to its serial console, which the host journal captures under microvm@<guest>.service and host-side Alloy ships to Loki. That stream carries caddy's JSON access log — the same lines CrowdSec reads for the WAN-facing proxy.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 38 },
      "id": 20,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "$logs" },
          "expr": "{job=\"host\", unit=~\"microvm@($instance).service\"} |= \"$search\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Guest console log",
      "type": "logs"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["caddy", "qt1-infra"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "Prometheus", "value": "prometheus" },
        "label": "Metrics",
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "current": { "selected": true, "text": "Loki", "value": "loki" },
        "label": "Logs",
        "name": "logs",
        "query": "loki",
        "type": "datasource"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "includeAll": true,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "label": "Proxy",
        "multi": true,
        "name": "instance",
        "query": "label_values(caddy_http_requests_in_flight{job=\"caddy\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "includeAll": true,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "label": "Vhost",
        "multi": true,
        "name": "vhost",
        "query": "label_values(caddy_http_request_duration_seconds_count{job=\"caddy\", instance=~\"$instance\"}, host)",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "text": "", "value": "" },
        "label": "Log filter",
        "name": "search",
        "options": [],
        "query": "",
        "type": "textbox"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "utc",
  "title": "Caddy / Overview",
  "uid": "qt1-caddy-overview"
}
