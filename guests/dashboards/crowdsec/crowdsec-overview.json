{
  "annotations": {
    "list": []
  },
  "description": "The host's CrowdSec: what it is banning right now, which scenarios fire, and whether its parsers are actually reading the caddy guest's access log. Metrics come from CrowdSec's own endpoint on the host (`cs_*`), the log panel from crowdsec.service and the firewall bouncer's journal in Loki.",
  "editable": false,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Summary",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Whether CrowdSec's metrics endpoint is answering at all.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "index": 1, "text": "Down" },
                "1": { "color": "green", "index": 0, "text": "Up" }
              },
              "type": "value"
            }
          ],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "max(up{job=\"crowdsec\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "CrowdSec",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Decisions in force right now — IPs the firewall bouncer is dropping. Counted from CrowdSec's own database at scrape time.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum(cs_active_decisions{job=\"crowdsec\"}) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Active bans",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Alerts CrowdSec has recorded (its own, excluding the community API's).",
      "fieldConfig": {
        "defaults": { "mappings": [], "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 4,
      "options": { "graphMode": "area", "textMode": "value" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum(cs_alerts{job=\"crowdsec\"}) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Alerts",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Scenarios that overflowed over the selected range — each overflow is what produces an alert and, per the profile, a ban.",
      "fieldConfig": {
        "defaults": { "mappings": [], "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 5,
      "options": { "graphMode": "none", "textMode": "value" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum(increase(cs_bucket_overflowed_total{job=\"crowdsec\"}[$__range])) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Overflows (range)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Log lines read out of the caddy guest's journal and successfully parsed, per second. Zero here while caddy is serving traffic means the acquisition or the parsers are broken, not that nothing is happening.",
      "fieldConfig": {
        "defaults": { "mappings": [], "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 6,
      "options": { "graphMode": "area", "textMode": "value" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum(rate(cs_parser_hits_ok_total{job=\"crowdsec\"}[$__rate_interval])) or vector(0)",
          "refId": "A"
        }
      ],
      "title": "Events parsed/s",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Leaky buckets currently alive — in-progress scenarios that have seen at least one event but not yet overflowed or expired.",
      "fieldConfig": {
        "defaults": { "mappings": [], "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 7,
      "options": { "graphMode": "area", "textMode": "value" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum(cs_buckets{job=\"crowdsec\"}) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Live buckets",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 8,
      "panels": [],
      "title": "Decisions",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Active decisions over time, by the scenario that caused them.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 20, "showPoints": "never", "stacking": { "mode": "normal" } },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 9,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum by (reason) (cs_active_decisions{job=\"crowdsec\"})",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "title": "Active decisions by scenario",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Where the decisions came from: `crowdsec` is this host's own scenarios firing on the caddy log, `CAPI`/`lists` are pulled from the community blocklists, `cscli` is a ban added by hand.",
      "fieldConfig": {
        "defaults": { "mappings": [], "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 10,
      "options": {
        "displayLabels": ["name", "value"],
        "legend": { "displayMode": "table", "placement": "right", "values": ["value"] },
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum by (origin, action) (cs_active_decisions{job=\"crowdsec\"})",
          "instant": true,
          "legendFormat": "{{origin}} / {{action}}",
          "refId": "A"
        }
      ],
      "title": "Active decisions by origin",
      "type": "piechart"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Bucket overflows per second, by scenario — the moment a ban is decided.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 20, "showPoints": "never", "stacking": { "mode": "normal" } },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["max"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum by (name) (rate(cs_bucket_overflowed_total{job=\"crowdsec\"}[$__rate_interval]))",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "Overflows by scenario",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Every scenario that has recorded an alert, worst first.",
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 12,
      "options": {
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Alerts" }]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum by (reason) (cs_alerts{job=\"crowdsec\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Alerts by scenario",
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "Value": "Alerts", "reason": "Scenario" } } }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 13,
      "panels": [],
      "title": "Acquisition and parsing",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Lines read per second from the journalctl acquisition — the caddy guest's mirrored console (see modules/crowdsec.nix).",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "showPoints": "never" },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 23 },
      "id": 14,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum by (source) (rate(cs_journalctlsource_hits_total{job=\"crowdsec\"}[$__rate_interval]))",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ],
      "title": "Lines read/s",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Parsed vs. unparsed events per second. A steady stream of unparsed lines means the acquisition is picking up something the caddy collection's parsers don't understand — expected here, since the caddy guest's console carries systemd and kernel lines as well as caddy's access log.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "showPoints": "never" },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 23 },
      "id": 15,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum(rate(cs_parser_hits_ok_total{job=\"crowdsec\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "parsed",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum(rate(cs_parser_hits_ko_total{job=\"crowdsec\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "unparsed",
          "refId": "B"
        }
      ],
      "title": "Parser outcome",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Events poured into each scenario's buckets per second: what the scenarios are actually considering, before any of them overflows.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "showPoints": "never" },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "id": 16,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum by (name) (rate(cs_bucket_poured_total{job=\"crowdsec\"}[$__rate_interval]))",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "Events poured/s by scenario",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "id": 17,
      "panels": [],
      "title": "Local API",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Requests per second to the loopback-only local API, by route. The firewall bouncer polling /v1/decisions/stream is the steady one.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "showPoints": "never" },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 32 },
      "id": 18,
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum by (route) (rate(cs_lapi_route_requests_total{job=\"crowdsec\"}[$__rate_interval]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "title": "LAPI requests/s by route",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Decision polls that returned something vs. nothing, per bouncer. A bouncer that stops appearing here has stopped polling — its bans go stale.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "showPoints": "never" },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 32 },
      "id": 19,
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum by (bouncer) (rate(cs_lapi_decisions_ok_total{job=\"crowdsec\"}[$__rate_interval]))",
          "legendFormat": "{{bouncer}} with decisions",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum by (bouncer) (rate(cs_lapi_decisions_ko_total{job=\"crowdsec\"}[$__rate_interval]))",
          "legendFormat": "{{bouncer}} empty",
          "refId": "B"
        }
      ],
      "title": "Bouncer decision polls/s",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Local API latency, 99th percentile per endpoint.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 0, "showPoints": "never" },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 32 },
      "id": 20,
      "options": {
        "legend": { "calcs": ["max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "histogram_quantile(0.99, sum by (le, endpoint) (rate(cs_lapi_request_duration_seconds_bucket{job=\"crowdsec\"}[$__rate_interval])))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "title": "LAPI p99 latency",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 },
      "id": 21,
      "panels": [],
      "title": "Logs",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "$logs" },
      "description": "CrowdSec's own journal on the host, plus the firewall bouncer's: this is where a ban is announced (\"Ban ip ... for ...\") and where a broken parser or hub update shows up.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 40 },
      "id": 22,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "$logs" },
          "expr": "{job=\"host\", unit=~\"crowdsec.*\"} |= \"$search\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "CrowdSec log",
      "type": "logs"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["crowdsec", "qt1-infra"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "Prometheus", "value": "prometheus" },
        "label": "Metrics",
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "current": { "selected": true, "text": "Loki", "value": "loki" },
        "label": "Logs",
        "name": "logs",
        "query": "loki",
        "type": "datasource"
      },
      {
        "current": { "text": "", "value": "" },
        "label": "Log filter",
        "name": "search",
        "options": [],
        "query": "",
        "type": "textbox"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "utc",
  "title": "CrowdSec / Overview",
  "uid": "qt1-crowdsec-overview"
}
